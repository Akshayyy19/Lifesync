# Copy this file to .env and fill in your own values.
# .env is already listed in .gitignore, so it will never be committed.

# Django
SECRET_KEY=replace-this-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Asia/Kolkata

# OpenWeatherMap — get a free key at https://openweathermap.org/api
# (the free "Current Weather Data" plan is all you need; new keys can
# take up to ~2 hours to activate after signup)
OPENWEATHERMAP_API_KEY=
DEFAULT_CITY=Chennai

# Database — leave DB_ENGINE unset to use SQLite (zero setup).
# Set DB_ENGINE=mysql to switch to MySQL, then fill in the values below.
# DB_ENGINE=mysql
# DB_NAME=lifesync
# DB_USER=root
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=3306
